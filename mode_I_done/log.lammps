LAMMPS (7 Aug 2019)
  using 1 OpenMP thread(s) per MPI task
# 3D Silicon Mode-I Crack Simulation using Stillinger-Weber
# Reads atom configuration from silicon.data file
# All atom types (1-5) already assigned in data file
# Crack geometry pre-defined through atom types 2 and 3

variable name string mode_1

# ============================================================================
# SIMULATION SETUP
# ============================================================================

dimension       3
boundary        s s p
units           metal
atom_style      atomic
neighbor        0.3 bin
neigh_modify    delay 5

# ============================================================================
# READ ATOM DATA FILE
# ============================================================================
# The data file contains:
# - All atoms with positions already set
# - Atom types pre-assigned:
#   Type 1: Interior bulk atoms
#   Type 2: Upper crack surface atoms
#   Type 3: Lower crack surface atoms
#   Type 4: Lower boundary grip atoms
#   Type 5: Upper boundary grip atoms

read_data       silicon.data
  orthogonal box = (-1.69964 -2.02544 0) to (2173.7 5432.03 5.43)
  5 by 16 by 1 MPI processor grid
  reading atoms ...
  3202801 atoms
  read_data CPU = 2.91455 secs

# ============================================================================
# POTENTIAL SETUP
# ============================================================================

pair_style      sw
pair_coeff      * * Si.sw Si Si Si Si Si

# ============================================================================
# REMOVE INTERACTIONS ACROSS CRACK
# ============================================================================
# Type 2 and 3 interactions are already defined by the data file geometry
# Remove pair interactions between crack faces to create the physical crack



# ============================================================================
# INITIAL EQUILIBRATION (NVT)
# ============================================================================

print "============ EQUILIBRATION PHASE ============"
============ EQUILIBRATION PHASE ============
print "Reading from: silicon.data"
Reading from: silicon.data
print "Atom types already assigned (1=bulk, 2=upper_crack, 3=lower_crack, 4=lower_grip, 5=upper_grip)"
Atom types already assigned (1=bulk, 2=upper_crack, 3=lower_crack, 4=lower_grip, 5=upper_grip)

# Define groups based on atom types
group           bulk type 1
3194795 atoms in group bulk
group           crack_upper type 2
801 atoms in group crack_upper
group           crack_lower type 3
801 atoms in group crack_lower
group           lower type 4
3202 atoms in group lower
group           upper type 5
3202 atoms in group upper
group           boundary union lower upper
6404 atoms in group boundary
group           mobile subtract all boundary
3196397 atoms in group mobile

neigh_modify    exclude type 2 3

# Set up mass (already done by read_data, but ensure correct)
mass            1 28.06
mass            2 28.06
mass            3 28.06
mass            4 28.06
mass            5 28.06

# Equilibrate at 1 K
fix             eq all nvt temp 1 1 0.1
thermo          100
thermo_style    custom step temp pe ke etotal vol press
run             5000
