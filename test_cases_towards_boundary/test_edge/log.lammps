variable topbound equal yhi-2
variable botbound equal ylo+2

#lower layer of atoms
region     1 block INF INF INF ${botbound} INF INF units box
region     1 block INF INF INF 1.457 INF INF units box
group  lower region 1
1601 atoms in group lower

#upper layer of atoms
region  2 block INF INF ${topbound} INF INF INF units box
region  2 block INF INF 5428.543 INF INF INF units box
group  upper region 2
1601 atoms in group upper

#rest of the regions
group  boundary union lower upper
3202 atoms in group boundary
group  mobile subtract all boundary
3199599 atoms in group mobile


# set crack position and length
variable quarter equal xhi/3 # crack elength for an edge crack
variable crack_pos_x equal yhi/2 # crack position
variable layer_1 equal (yhi+8.145)/2
variable layer_2 equal (yhi-8.145)/2


region  leftupper block INF ${quarter} ${crack_pos_x} ${layer_1} INF INF units box
region  leftupper block INF 724.0724 ${crack_pos_x} ${layer_1} INF INF units box
region  leftupper block INF 724.0724 2715.2715 ${layer_1} INF INF units box
region  leftupper block INF 724.0724 2715.2715 2719.344 INF INF units box
region  leftlower block INF ${quarter} ${layer_2} ${crack_pos_x} INF INF units box
region  leftlower block INF 724.0724 ${layer_2} ${crack_pos_x} INF INF units box
region  leftlower block INF 724.0724 2711.199 ${crack_pos_x} INF INF units box
region  leftlower block INF 724.0724 2711.199 2715.2715 INF INF units box
group  leftupper region leftupper
801 atoms in group leftupper
group  leftlower region leftlower
801 atoms in group leftlower


# setup for different groups
set  group leftupper type 2
  801 settings made for type
set  group leftlower type 3
  801 settings made for type
set  group lower type 4
  1601 settings made for type
set  group upper type 5
  1601 settings made for type



# initial velocities
compute    	new mobile temp
velocity 	mobile create 0.1 218552 temp new
velocity 	upper set 0.0 0.015 0.0
velocity 	lower set 0.0 -0.015 0.0

# Cmpute virial stresses
compute stress all stress/atom NULL
compute summ all reduce sum c_stress[1] c_stress[2] c_stress[3]
compute vvol all voronoi/atom

# fixes

fix  2 boundary setforce NULL 0.0 NULL

#set variables for output
variable	le equal ly
variable	tstp equal step
variable	virial equal c_summ[2]
dump 	1 all custom 2000 dump.${name}.* id type x y z vy c_stress[2] c_vvol[1]
dump 	1 all custom 2000 dump.tstp.* id type x y z vy c_stress[2] c_vvol[1]
fix 	print all print 100 "${tstp} ${le} ${virial}" file virial_stress_data.txt screen yes


# run

timestep 	0.01
thermo  	200
thermo_modify 	temp new
WARNING: Temperature for thermo pressure is not for group all (../thermo.cpp:485)
neigh_modify 	exclude type 2 3
run  		184000
