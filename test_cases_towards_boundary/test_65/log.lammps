variable topbound equal yhi-2
variable botbound equal ylo+2
variable toplayer equal yhi-4.715
variable botlayer equal ylo+4.715

#lower layer of atoms
region     1 block INF INF INF ${botbound} INF INF units box
region     1 block INF INF INF 1.457 INF INF units box
region	   blayer block INF INF ${botbound} ${botlayer} INF INF units box
region	   blayer block INF INF 1.457 ${botlayer} INF INF units box
region	   blayer block INF INF 1.457 4.172 INF INF units box
group  lower region 1
1601 atoms in group lower

#upper layer of atoms
region  2 block INF INF ${topbound} INF INF INF units box
region  2 block INF INF 5428.543 INF INF INF units box
region  tlayer block INF INF ${toplayer} ${topbound} INF INF units box
region  tlayer block INF INF 5425.828 ${topbound} INF INF units box
region  tlayer block INF INF 5425.828 5428.543 INF INF units box
group  upper region 2
1601 atoms in group upper

#rest of the regions
group  boundary union lower upper
3202 atoms in group boundary
group  mobile subtract all boundary
3199599 atoms in group mobile


# set crack position and length
variable left_end equal xhi/3 # left end crack tip
variable right_end equal xhi/1.5 # right end crack tip
variable crack_pos_x equal 26*yhi/40 # crack position
variable layer_1 equal (26*yhi/40)+(8.145)/2
variable layer_2 equal (26*yhi/40)-(8.145)/2
variable layer_3 equal (26*yhi/40)+(8.145)/2
variable layer_4 equal (26*yhi/40)-(8.145)/2


region  leftupper block ${left_end} ${right_end} ${crack_pos_x} ${layer_1} INF INF units box
region  leftupper block 724.0724 ${right_end} ${crack_pos_x} ${layer_1} INF INF units box
region  leftupper block 724.0724 1448.1448 ${crack_pos_x} ${layer_1} INF INF units box
region  leftupper block 724.0724 1448.1448 3529.85295 ${layer_1} INF INF units box
region  leftupper block 724.0724 1448.1448 3529.85295 3533.92545 INF INF units box
region  leftlower block ${left_end} ${right_end} ${layer_2} ${crack_pos_x} INF INF units box
region  leftlower block 724.0724 ${right_end} ${layer_2} ${crack_pos_x} INF INF units box
region  leftlower block 724.0724 1448.1448 ${layer_2} ${crack_pos_x} INF INF units box
region  leftlower block 724.0724 1448.1448 3525.78045 ${crack_pos_x} INF INF units box
region  leftlower block 724.0724 1448.1448 3525.78045 3529.85295 INF INF units box
region  seclower block ${right_end} INF ${layer_4} ${crack_pos_x} INF INF units box
region  seclower block 1448.1448 INF ${layer_4} ${crack_pos_x} INF INF units box
region  seclower block 1448.1448 INF 3525.78045 ${crack_pos_x} INF INF units box
region  seclower block 1448.1448 INF 3525.78045 3529.85295 INF INF units box
region  secupper block ${right_end} INF ${crack_pos_x} ${layer_3} INF INF units box
region  secupper block 1448.1448 INF ${crack_pos_x} ${layer_3} INF INF units box
region  secupper block 1448.1448 INF 3529.85295 ${layer_3} INF INF units box
region  secupper block 1448.1448 INF 3529.85295 3533.92545 INF INF units box

group  leftupper region leftupper
799 atoms in group leftupper
group  leftlower region leftlower
800 atoms in group leftlower
group  seclower region seclower
801 atoms in group seclower
group  secupper region secupper
801 atoms in group secupper
group  blayer region blayer
1601 atoms in group blayer
group  tlayer region tlayer
1601 atoms in group tlayer
group  study union seclower secupper
1602 atoms in group study
group  layer union blayer tlayer
3202 atoms in group layer
# setup for different groups
set  group leftupper type 2
  799 settings made for type
set  group leftlower type 3
  800 settings made for type
set  group lower type 4
  1601 settings made for type
set  group upper type 5
  1601 settings made for type
set  group secupper type 6
  801 settings made for type
set  group seclower type 7
  801 settings made for type
set  group tlayer type 8
  1601 settings made for type
set  group blayer type 9
  1601 settings made for type



# initial velocities
compute    	new mobile temp
velocity 	mobile create 0.1 218552 temp new
velocity 	upper set 0.0 0.5 0.0
velocity 	lower set 0.0 0.000 0.0

# Cmpute virial stresses
compute stress all stress/atom NULL
compute summ all reduce sum c_stress[1] c_stress[2] c_stress[3]
compute vvol all voronoi/atom

# fixes

fix  2 boundary setforce NULL 0.0 NULL

#set variables for output
variable	le equal ly
variable	tstp equal step
variable	virial equal c_summ[2]
#dump 	1 all custom 200 dump.${name}.* id type x y z vy c_stress[2] c_vvol[1]
dump 	22 study custom 200 dump_study.${name}.* id type x y z vy c_stress[2] c_vvol[1]
dump 	22 study custom 200 dump_study.tstp.* id type x y z vy c_stress[2] c_vvol[1]
dump 	33 layer custom 200 dump_layer.${name}.* id type x y z vy c_stress[2] c_vvol[1]
dump 	33 layer custom 200 dump_layer.tstp.* id type x y z vy c_stress[2] c_vvol[1]
fix 	print all print 50 "${tstp} ${le} ${virial}" file virial_stress_data.txt screen yes


# run

timestep 	0.005
thermo  	200
thermo_modify 	temp new
WARNING: Temperature for thermo pressure is not for group all (../thermo.cpp:485)
neigh_modify 	exclude type 2 3
run  		15000
